+// A page-flip completion that never arrives strands the output for good: the
+// scheduler keeps the frame pending, CDRMOutput::commitState refuses every buffer
+// commit with "Cannot commit when a page-flip is awaiting", and scheduleFrame
+// returns early -- so nothing ever asks for the frame that would clear it. The
+// kernel does not always deliver flip_done: a DP link retrain behind a monitor
+// input switch, a driver-side flip timeout, or a sink that drops the flip across a
+// hotplug all end the same way, and only a modeset shakes it loose.
+//
+// restoreAfterVT() and the modeset path in commitState already drop flips whose
+// completion is known to be lost. This is the same treatment for the losses nobody
+// gets told about: give the in-flight frame a deadline and drop it once it passes.
+// The commit that follows either flips, or is refused by the kernel and taken
+// through commitState's existing re-modeset retry, which is the recovery a manual
+// DPMS off/on performs by hand.
+bool Aquamarine::SDRMConnector::reapStalledFrame() {
+    // One second sits far outside any legitimate submit-to-flip_done window: over
+    // 200 vblanks at 240Hz, and 50 at the slowest mode a sink is likely to offer. A
+    // healthy pipeline cannot reach it, and a flip still outstanding by then is not
+    // going to land on its own.
+    static constexpr auto PAGE_FLIP_DEADLINE = std::chrono::seconds(1);
+
+    // a frame mid-emit is not stalled, and clearing the scheduler out from under a
+    // live CFrameRunningGuard would stomp on its bookkeeping.
+    if (sched.frameRunning() || !sched.frameInFlight() || sched.frameInFlightFor() < PAGE_FLIP_DEADLINE)
+        return false;
+
+    backend->backend->log(AQ_LOG_ERROR,
+                          std::format("drm: page-flip on {} never completed after {}ms, dropping it to unblock the output", szName,
+                                      std::chrono::duration_cast<std::chrono::milliseconds>(sched.frameInFlightFor()).count()));
+
+    invalidateFrame();
+
+    return true;
+}
+
 void Aquamarine::SDRMConnector::invalidateFrame() {
     sched.invalidate();
 
