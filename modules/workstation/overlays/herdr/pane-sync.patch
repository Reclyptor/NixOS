+    snapshot
+}
+
+fn pane_input_ids(outcome: &ClientShellInput) -> Vec<&str> {
+    outcome
+        .requests
+        .iter()
+        .filter_map(|request| match request {
+            ClientMessage::ClientShellPaneInput { pane_id, .. } => Some(pane_id.as_str()),
+            _ => None,
+        })
+        .collect()
+}
+
+#[test]
+fn synchronized_panes_fan_out_terminal_input_only_within_the_active_tab() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(synchronized_snapshot()));
+    state.record_binding(
+        crate::input::KeybindMatch::Action(crate::input::KeybindAction::TogglePaneSynchronization),
+        &mut ClientShellInput::default(),
+    );
+    assert!(state.synchronization_enabled_for_focused_tab());
+
+    let key = state.handle_input_bytes(b"x");
+    assert_eq!(pane_input_ids(&key), ["pane_1", "pane_2"]);
+    let text = state.handle_raw_events(vec![RawInputEvent::Text(crate::input::TextCommit::new(
+        "text",
+    ))]);
+    assert_eq!(pane_input_ids(&text), ["pane_1", "pane_2"]);
+    let paste = state.handle_raw_events(vec![RawInputEvent::Paste("paste".into())]);
+    assert_eq!(pane_input_ids(&paste), ["pane_1", "pane_2"]);
+
+    let mut next_tab = synchronized_snapshot();
+    next_tab.focused_tab_id = Some("tab_2".into());
+    next_tab.focused_pane_id = Some("pane_3".into());
+    next_tab.panes[0].focused = false;
+    next_tab.panes[2].focused = true;
+    next_tab.tabs[0].focused = false;
+    next_tab.tabs[1].focused = true;
+    state.set_snapshot(Box::new(next_tab));
+    assert!(!state.synchronization_enabled_for_focused_tab());
+    let isolated = state.handle_input_bytes(b"y");
+    assert_eq!(pane_input_ids(&isolated), ["pane_3"]);
+}
