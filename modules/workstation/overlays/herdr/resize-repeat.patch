diff --git a/src/client/shell/tests/keybindings_settings.rs b/src/client/shell/tests/keybindings_settings.rs
index fd3301d..c9c2936 100644
--- a/src/client/shell/tests/keybindings_settings.rs
+++ b/src/client/shell/tests/keybindings_settings.rs
@@ -965,3 +965,88 @@ fn resize_mode_reuses_endpoint_resize_and_stays_active_until_done() {
     assert!(state.handle_input_bytes(b"\r").actions.is_empty());
     assert_eq!(state.mode, ClientShellMode::Terminal);
 }
+
+#[test]
+fn prefixed_resize_repeats_without_the_prefix_until_another_key() {
+    fn resized(outcome: &ClientShellInput) -> Option<crate::api::schema::PaneDirection> {
+        match &outcome.actions[..] {
+            [ClientShellAction::Endpoint { request, .. }] => match &request.method {
+                crate::api::schema::Method::PaneResize(params) => Some(params.direction),
+                other => panic!("resize should send a pane resize, got {other:?}"),
+            },
+            [] => None,
+            other => panic!("resize should emit at most one request, got {other:?}"),
+        }
+    }
+
+    let config: Config = toml::from_str(
+        r#"
+        [keys]
+        resize_pane_left = "prefix+shift+h"
+        resize_pane_right = "prefix+shift+l"
+        "#,
+    )
+    .expect("configuration parses");
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_pane_surface(surface());
+
+    assert!(state.handle_input_bytes(&[0x02]).actions.is_empty());
+    assert_eq!(
+        resized(&state.handle_input_bytes(b"H")),
+        Some(crate::api::schema::PaneDirection::Left)
+    );
+    assert_eq!(state.mode, ClientShellMode::Resize);
+
+    // No prefix from here: the bound keys and the mode's own hjkl keep going.
+    assert_eq!(
+        resized(&state.handle_input_bytes(b"H")),
+        Some(crate::api::schema::PaneDirection::Left)
+    );
+    assert_eq!(
+        resized(&state.handle_input_bytes(b"L")),
+        Some(crate::api::schema::PaneDirection::Right)
+    );
+    assert_eq!(
+        resized(&state.handle_input_bytes(b"h")),
+        Some(crate::api::schema::PaneDirection::Left)
+    );
+    assert_eq!(state.mode, ClientShellMode::Resize);
+
+    // Any other key ends the repeat and reaches the pane, as after tmux's -r.
+    let typed = state.handle_input_bytes(b"x");
+    assert_eq!(state.mode, ClientShellMode::Terminal);
+    assert!(typed.actions.is_empty());
+    assert!(matches!(
+        &typed.requests[..],
+        [ClientMessage::ClientShellPaneInput { events, .. }]
+            if matches!(
+                &events[..],
+                [ClientPaneInputEvent::Key {
+                    code: crate::protocol::ClientKeyCode::Char('x'),
+                    ..
+                }, ..]
+            )
+    ));
+}
+
+#[test]
+fn prefix_after_a_resize_repeat_starts_a_new_binding() {
+    let config: Config = toml::from_str(
+        r#"
+        [keys]
+        resize_pane_left = "prefix+shift+h"
+        "#,
+    )
+    .expect("configuration parses");
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_pane_surface(surface());
+
+    state.handle_input_bytes(&[0x02]);
+    state.handle_input_bytes(b"H");
+    assert_eq!(state.mode, ClientShellMode::Resize);
+
+    assert!(state.handle_input_bytes(&[0x02]).requests.is_empty());
+    assert_eq!(state.mode, ClientShellMode::Prefix);
+}
