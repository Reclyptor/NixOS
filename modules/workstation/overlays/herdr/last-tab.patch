diff --git a/src/client/shell/tests/workspace_navigation.rs b/src/client/shell/tests/workspace_navigation.rs
index dff7f7d..8fd5ab2 100644
--- a/src/client/shell/tests/workspace_navigation.rs
+++ b/src/client/shell/tests/workspace_navigation.rs
@@ -1026,3 +1026,74 @@ fn kitty_ctrl_bracket_cancels_a_blocked_foreign_preview() {
     assert_ne!(state.mode, ClientShellMode::Navigate);
     assert!(state.navigate_workspace_id.is_none());
 }
+
+#[test]
+fn last_tab_returns_to_the_previous_tab_within_the_active_workspace() {
+    fn focus(snapshot: &mut ClientShellSnapshot, revision: u64, workspace: &str, tab: &str) {
+        snapshot.revision = revision;
+        snapshot.focused_workspace_id = Some(workspace.into());
+        snapshot.focused_tab_id = Some(tab.into());
+        for entry in &mut snapshot.tabs {
+            entry.focused = entry.tab_id == tab;
+        }
+    }
+    fn last_tab(state: &mut ClientShellState) -> Option<String> {
+        let mut input = ClientShellInput::default();
+        state.record_binding(
+            crate::input::KeybindMatch::Action(crate::input::KeybindAction::LastTab),
+            &mut input,
+        );
+        // With nothing to return to, the action falls through as an inert
+        // Keybind, exactly like last_pane; only endpoint requests move focus.
+        let requests = input
+            .actions
+            .iter()
+            .filter_map(|action| match action {
+                ClientShellAction::Endpoint { request, .. } => Some(&request.method),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        match requests[..] {
+            [] => None,
+            [crate::api::schema::Method::TabFocus(target)] => Some(target.tab_id.clone()),
+            ref other => panic!("last tab should send at most one tab focus, got {other:?}"),
+        }
+    }
+
+    let mut projected = snapshot();
+    let mut second_workspace = projected.workspaces[0].clone();
+    second_workspace.workspace_id = "ws_2".into();
+    second_workspace.active_tab_id = "tab_3".into();
+    second_workspace.focused = false;
+    projected.workspaces.push(second_workspace);
+    for (tab_id, workspace_id) in [("tab_2", "ws_1"), ("tab_3", "ws_2")] {
+        let mut tab = projected.tabs[0].clone();
+        tab.tab_id = tab_id.into();
+        tab.workspace_id = workspace_id.into();
+        tab.focused = false;
+        projected.tabs.push(tab);
+    }
+
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(projected.clone()));
+    assert_eq!(last_tab(&mut state), None, "no tab history yet");
+
+    focus(&mut projected, 2, "ws_1", "tab_2");
+    state.set_snapshot(Box::new(projected.clone()));
+    assert_eq!(last_tab(&mut state).as_deref(), Some("tab_1"));
+
+    // Leaving the workspace is not a tab change inside it: ws_2 has no history,
+    // and last_tab must not pull focus back across workspaces.
+    focus(&mut projected, 3, "ws_2", "tab_3");
+    state.set_snapshot(Box::new(projected.clone()));
+    assert_eq!(last_tab(&mut state), None);
+
+    focus(&mut projected, 4, "ws_1", "tab_2");
+    state.set_snapshot(Box::new(projected.clone()));
+    assert_eq!(last_tab(&mut state).as_deref(), Some("tab_1"));
+
+    projected.revision = 5;
+    projected.tabs.retain(|tab| tab.tab_id != "tab_1");
+    state.set_snapshot(Box::new(projected));
+    assert_eq!(last_tab(&mut state), None, "a closed tab is forgotten");
+}
