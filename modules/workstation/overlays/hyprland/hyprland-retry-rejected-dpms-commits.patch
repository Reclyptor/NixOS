+// The DRM backend rejects a commit for reasons that clear on their own -- a disable and
+// an enable sent almost together, or a connector still settling after a hotplug. Those
+// resolve over hundreds of milliseconds, so back off across a window that can outlast
+// them instead of taking a single shot two frames later.
+//
+// If the window is exhausted the target is reconciled with what actually committed, so
+// intent and reality agree again: the next toggle inverts a state the panel is really in,
+// and an explicit request is no longer mistaken for one already in flight.
+void CMonitor::scheduleDPMSRetry() {
+    static constexpr int MAX_DPMS_RETRIES = 8;
+    static constexpr int FIRST_DELAY_MS   = 50;
+    static constexpr int MAX_DELAY_MS     = 2000;
+
+    if (m_dpmsRetryCount >= MAX_DPMS_RETRIES) {
+        Log::logger->log(Log::ERR, "Gave up committing output {} for DPMS = {} after {} attempts, leaving it on {}", m_name, m_dpmsTarget, m_dpmsRetryCount, m_dpmsStatus);
+        clearDPMSRetry();
+        m_dpmsAwaitingCommit = false;
+
+        // stop calling it a target once it has been given up on. left pointing at a state
+        // that never committed, it would make the next toggle invert an intention the
+        // compositor has already abandoned and ask for the state already on the panel.
+        m_dpmsTarget = m_dpmsStatus;
         return;
     }
 
-    if (state)
-        g_pHyprRenderer->damageMonitor(m_self.lock());
+    int delayMs = FIRST_DELAY_MS << m_dpmsRetryCount;
+    if (delayMs > MAX_DELAY_MS)
+        delayMs = MAX_DELAY_MS;
+
+    m_dpmsRetryCount++;
+
+    // Safe from inside the timer's own callback: the event loop copies its timer list
+    // before dispatching and hands the timer to the callback by value.
+    cancelDPMSRetryTimer();
+
+    m_dpmsRetryTimer = makeShared<CEventLoopTimer>(
+        std::chrono::milliseconds(delayMs),
+        [this, self = m_self](SP<CEventLoopTimer>, void*) {
+            if (!self)
+                return;
+
+            commitDPMSState(m_dpmsTarget);
+        },
+        nullptr);
+    g_pEventLoopManager->addTimer(m_dpmsRetryTimer);
+}
+
+void CMonitor::cancelDPMSRetryTimer() {
+    if (!m_dpmsRetryTimer)
+        return;
+
+    m_dpmsRetryTimer->cancel();
+    g_pEventLoopManager->removeTimer(m_dpmsRetryTimer);
+    m_dpmsRetryTimer.reset();
+}
+
+void CMonitor::clearDPMSRetry() {
+    cancelDPMSRetryTimer();
+    m_dpmsRetryCount = 0;
 }
 
