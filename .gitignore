# Secrets and keys
secrets/keys.txt
*.key
keys.txt

# SOPS age keys should never be committed
.config/sops/age/

# Specs are working documents, not configuration. This is a configuration-only
# repo, so they stay local and are never checked in. One spec per branch, at
# SPEC/<branch-slug>.md: a single shared SPEC.md let concurrent agent sessions
# silently overwrite each other's work. The bare SPEC.md rule is kept so a
# stale one left by an older session still cannot be committed.
SPEC/
SPEC.md

# Agent working directories — per-session local state, not configuration.
# Only the dotted paths; modules/home/{claude,codex}/ are real config and stay
# tracked.
.claude/
.crush/
.codex/

# Build outputs
result
result-*

# Nix build artifacts
*.drv

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

